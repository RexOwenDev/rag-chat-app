# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only (Inngest, migrations). NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Two DB connection strings (Supabase Dashboard → Project Settings → Database)
# Direct: for Inngest step functions and migrations (long-lived connections ok)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Pooled: for Next.js API routes (PgBouncer, prevents connection exhaustion)
DATABASE_URL_POOLED=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# ─── Vercel AI Gateway ────────────────────────────────────────────────────────
# Provisioned automatically by: vercel env pull .env.local --yes
# Expires every ~24h — refresh with: vercel env pull .env.local --yes
# DO NOT set manually. See: https://vercel.com/docs/ai-gateway#authentication
VERCEL_OIDC_TOKEN=

# ─── OpenAI (embeddings only) ─────────────────────────────────────────────────
# Named OPENAI_EMBED_KEY (not the SDK default) to prevent accidental use for generation.
# Pass explicitly: new OpenAI({ apiKey: process.env.OPENAI_EMBED_KEY })
OPENAI_EMBED_KEY=sk-...

# ─── Cohere (reranking only) ──────────────────────────────────────────────────
# Free tier: 1000 rerank calls/month. https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# ─── Inngest (background jobs) ────────────────────────────────────────────────
# Get from: https://app.inngest.com/settings
INNGEST_SIGNING_KEY=signkey-...
INNGEST_EVENT_KEY=...

# ─── Upstash Redis (rate limiting + embedding cache) ──────────────────────────
# Provisioned automatically via: vercel integration add upstash
# Then: vercel env pull .env.local --yes
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─── Error Monitoring ─────────────────────────────────────────────────────────
# Get from: https://sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN=https://...@sentry.io/...

# ─── Visuals (scripts/generate-hero.mjs only) ─────────────────────────────────
# Only needed to regenerate the hero image. Not required for app runtime.
GEMINI_API_KEY=
